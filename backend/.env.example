DATABASE_URL="postgresql://postgres:password@localhost:5432/tepilog?schema=public"
JWT_SECRET="change-this-to-a-secure-secret"
JWT_REFRESH_SECRET="change-this-to-another-secure-secret"
JWT_EXPIRES_IN="1h"
JWT_REFRESH_EXPIRES_IN="7d"
PORT=3000

# CORS: daftar origin frontend yang diizinkan, dipisah koma.
# Kosongkan untuk mengizinkan semua origin (hanya untuk development).
# Contoh: CORS_ORIGIN="https://tepilog.app,https://www.tepilog.app"
CORS_ORIGIN=""

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"
